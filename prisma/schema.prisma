generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum IdeaStatus {
  NEW
  EXPLORING
  SAVED
  DISCARDED
  CONVERTED
}

enum InboxItemType {
  TASK
  PROJECT
  IDEA
  NOTE
  UNKNOWN
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  HOUSING
  SERVICES
  SOFTWARE
  HEALTH
  EDUCATION
  ENTERTAINMENT
  SHOPPING
  OTHER
}

enum HabitPeriod {
  DAILY
  WEEKLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FileProcessingStatus {
  READY
  NO_TEXT
}

model User {
  id         String             @id @default(uuid()) @db.Uuid
  name       String             @db.VarChar(120)
  email      String             @unique @db.VarChar(320)
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @db.Timestamptz(3)
  projects   Project[]
  tasks      Task[]
  ideas      Idea[]
  notes      Note[]
  expenses   Expense[]
  habits     Habit[]
  habitLogs  HabitLog[]
  goals      Goal[]
  inboxItems InboxItem[]
  files      ProjectFile[]
  fileChunks ProjectFileChunk[]
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  name        String        @db.VarChar(160)
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  archivedAt  DateTime?     @db.Timestamptz(3)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  ideas       Idea[]
  notes       Note[]
  expenses    Expense[]
  files       ProjectFile[]

  @@unique([userId, name])
  @@index([userId, status])
}

model ProjectFile {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @db.Uuid
  projectId        String               @db.Uuid
  originalName     String               @db.VarChar(255)
  mimeType         String               @db.VarChar(120)
  size             Int
  sha256           String               @db.Char(64)
  data             Bytes                @db.ByteA
  extractedText    String?              @db.Text
  processingStatus FileProcessingStatus
  textTruncated    Boolean              @default(false)
  pageCount        Int?
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks           ProjectFileChunk[]

  @@unique([projectId, sha256])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

model ProjectFileChunk {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  fileId      String      @db.Uuid
  chunkIndex  Int
  content     String      @db.Text
  contentHash String      @db.Char(64)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  file        ProjectFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, chunkIndex])
  @@index([userId, fileId])
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  projectId   String?      @db.Uuid
  title       String       @db.VarChar(240)
  description String?      @db.Text
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?    @db.Date
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  completedAt DateTime?    @db.Timestamptz(3)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, status, dueDate])
  @@index([projectId])
}

model Idea {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  projectId   String?    @db.Uuid
  title       String     @db.VarChar(240)
  description String?    @db.Text
  status      IdeaStatus @default(NEW)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([projectId])
}

model Note {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  projectId String?  @db.Uuid
  title     String?  @db.VarChar(240)
  content   String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([projectId])
}

model InboxItem {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  originalText String         @db.Text
  detectedType InboxItemType?
  processed    Boolean        @default(false)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  processedAt  DateTime?      @db.Timestamptz(3)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, processed, createdAt])
}

model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  projectId   String?         @db.Uuid
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("PEN") @db.Char(3)
  description String          @db.VarChar(240)
  category    ExpenseCategory
  date        DateTime        @db.Date
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, category, date])
  @@index([projectId])
}

model Habit {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  name        String      @db.VarChar(160)
  description String?     @db.Text
  period      HabitPeriod
  targetCount Int?
  unit        String      @default("sesiones") @db.VarChar(40)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        HabitLog[]

  @@unique([userId, name])
  @@index([userId, active])
}

model HabitLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  habitId   String   @db.Uuid
  value     Decimal  @default(1) @db.Decimal(10, 2)
  date      DateTime @db.Date
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([habitId, date])
}

model Goal {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  title       String     @db.VarChar(240)
  description String?    @db.Text
  targetDate  DateTime?  @db.Date
  status      GoalStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  completedAt DateTime?  @db.Timestamptz(3)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, targetDate])
}
