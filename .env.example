# Configuración general (sin secretos)
APP_TIMEZONE=America/Lima
LIFEOS_OWNER_EMAIL=owner@lifeos.local

# PostgreSQL local de Docker (solo escucha en 127.0.0.1:5433).
# El modo trust se usa únicamente para este contenedor de desarrollo aislado.
DATABASE_URL="postgresql://lifeos@127.0.0.1:5433/lifeos?schema=public"

# Gemini se usa exclusivamente desde el servidor. Crea la clave en Google AI
# Studio y colócala manualmente en .env; nunca la publiques en Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
