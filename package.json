{
  "name": "lifeos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:status": "prisma migrate status --config prisma7.config.ts",
    "db:seed": "prisma db seed --config prisma7.config.ts",
    "db:studio": "prisma studio --config prisma7.config.ts",
    "db:verify": "tsx --conditions=react-server scripts/verify-crud.ts",
    "ui:verify": "tsx --conditions=react-server scripts/verify-ui.ts",
    "ai:verify": "tsx --conditions=react-server scripts/verify-ai.ts",
    "ai:verify:live": "tsx --conditions=react-server scripts/verify-gemini-live.ts",
    "chat:verify": "tsx --conditions=react-server scripts/verify-chat.ts",
    "brain-dump:verify": "tsx --conditions=react-server scripts/verify-brain-dump.ts",
    "brain-dump:verify:live": "tsx --conditions=react-server scripts/verify-brain-dump-live.ts",
    "queries:verify": "tsx --conditions=react-server scripts/verify-smart-queries.ts",
    "queries:verify:live": "tsx --conditions=react-server scripts/verify-smart-queries-live.ts",
    "review:verify": "tsx --conditions=react-server scripts/verify-reviews.ts",
    "expenses:verify": "tsx --conditions=react-server scripts/verify-expenses.ts",
    "images:verify": "tsx --conditions=react-server scripts/verify-image-capture.ts",
    "audio:verify": "tsx --conditions=react-server scripts/verify-audio-capture.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.4",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
